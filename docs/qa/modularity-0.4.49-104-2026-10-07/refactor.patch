+import Combine
+import Foundation
+
+/// Owns recoverable editor models and their subscriptions for one app session.
+/// AppState keeps route selection and the published note binding; neither views
+/// nor navigation create a second copy of a capture's draft.
+@MainActor
+final class AppDraftSession {
+    struct RecoveredNote {
+        let text: String
+        let destination: ComposerDestination?
+    }
+
+    let newTask = NewTaskDraft()
+    private let archive: DraftArchive
+    private var details: [UUID: CaptureDraft] = [:]
+    private var detailSubscriptions: [UUID: Set<AnyCancellable>] = [:]
+    private var composerSubscriptions = Set<AnyCancellable>()
+    private var isObservingComposers = false
+    private var isStopped = false
+
+    private(set) var persistenceError: String? {
+        didSet { onPersistenceErrorChange?(persistenceError) }
+    }
+    var onPersistenceErrorChange: ((String?) -> Void)?
+    var onPersistenceRequested: (() -> Void)?
+    var onNewTaskChange: (() -> Void)?
+    var onDetailChange: ((UUID, CaptureDraft) -> Void)?
+
+    init(root: URL) { archive = DraftArchive(root: root) }
+
+    var hasDetailChanges: Bool { details.values.contains(where: \.hasChanges) }
+
+    func existingDraft(for id: UUID) -> CaptureDraft? { details[id] }
+
+    func draft(for capture: Capture) -> CaptureDraft {
+        if let existing = details[capture.id] { return existing }
+        let draft = CaptureDraft(capture: capture)
+        details[capture.id] = draft
+        observe(draft, id: capture.id)
+        return draft
+    }
+
+    func removeDraft(for id: UUID) {
+        detailSubscriptions.removeValue(forKey: id)
+        details.removeValue(forKey: id)
+    }
+
+    /// Install after recovery so loading a sidecar cannot schedule a new write.
+    /// The app's note publisher remains the sole owner of its text and binding.
+    func observeComposers(noteChanges: Published<String>.Publisher) {
+        guard !isObservingComposers, !isStopped else { return }
+        isObservingComposers = true
+        noteChanges.dropFirst().debounce(for: .milliseconds(150), scheduler: RunLoop.main)
+            .sink { [weak self] _ in self?.onPersistenceRequested?() }
+            .store(in: &composerSubscriptions)
+        newTask.objectWillChange.debounce(for: .milliseconds(150), scheduler: RunLoop.main)
+            .sink { [weak self] _ in self?.onPersistenceRequested?() }
+            .store(in: &composerSubscriptions)
+        newTask.objectWillChange.sink { [weak self] _ in self?.onNewTaskChange?() }
+            .store(in: &composerSubscriptions)
+    }
+
+    func persist(note: String, noteDestination: ComposerDestination?, fallbackTaskProject: String?) {
+        var snapshot = DraftArchiveSnapshot()
+        snapshot.note = note
+        snapshot.noteDestination = noteDestination
+        snapshot.task = ComposerSnapshot(text: newTask.text, planning: newTask.planning,
+            reminderEnabled: newTask.reminderEnabled, reminderMode: newTask.reminderMode.rawValue,
+            countdownHours: newTask.countdownHours, countdownMinutes: newTask.countdownMinutes,
+            reminderDate: newTask.reminderDate,
+            destination: newTask.destination ?? ComposerDestination(projectName: fallbackTaskProject),
+            pendingChecklistText: newTask.pendingChecklistText)
+        snapshot.details = details.compactMap { id, draft in
+            guard draft.hasChanges || !draft.commentComposer.isEmpty || draft.editingCommentID != nil else { return nil }
+            return DetailDraftSnapshot(captureID: id, title: draft.title, comment: draft.comment, planning: draft.planning,
+                committedPlanning: draft.committedPlanningForRecovery,
+                committedReminderRevision: draft.committedReminderRevisionForRecovery,
+                reminderEnabled: draft.reminderEnabled, reminderMode: draft.reminderMode.rawValue,
+                countdownHours: draft.countdownHours, countdownMinutes: draft.countdownMinutes, reminderDate: draft.reminderDate,
+                commentComposer: draft.commentComposer, editingCommentID: draft.editingCommentID,
+                pendingChecklistText: draft.pendingChecklistText)
+        }
+        do { try archive.save(snapshot); persistenceError = nil }
+        catch { persistenceError = "Drafts are still in memory. \(error.localizedDescription)" }
+    }
+
+    /// Recover against committed records, preserving pending fields while newer
+    /// immediate timing/reminder actions retain ownership of their saved values.
+    func restore(captures: [Capture], legacyProject: String?) -> RecoveredNote? {
+        guard let snapshot = archive.load() else { persistenceError = archive.recoveryError; return nil }
+        newTask.destination = snapshot.task.destination ?? ComposerDestination(projectName: legacyProject)
+        newTask.text = snapshot.task.text
+        newTask.planning = snapshot.task.planning
+        newTask.pendingChecklistText = snapshot.task.pendingChecklistText ?? ""
+        newTask.reminderEnabled = snapshot.task.reminderEnabled
+        newTask.reminderMode = ReminderScheduleMode(rawValue: snapshot.task.reminderMode) ?? .date
+        newTask.countdownHours = snapshot.task.countdownHours
+        newTask.countdownMinutes = snapshot.task.countdownMinutes
+        newTask.reminderDate = snapshot.task.reminderDate
+        for saved in snapshot.details {
+            guard let capture = captures.first(where: { $0.id == saved.captureID }) else { continue }
+            let draft = CaptureDraft(capture: capture)
+            draft.title = saved.title ?? capture.title
+            draft.comment = saved.comment
+            draft.commentComposer = saved.commentComposer ?? ""
+            draft.editingCommentID = saved.editingCommentID
+            draft.pendingChecklistText = saved.pendingChecklistText ?? ""
+            draft.restorePlanning(saved.planning, baseline: saved.committedPlanning, from: capture)
+            // Clear and Snooze commit before the debounced sidecar. A stale
+            // recovery file must not resurrect an already committed reminder.
+            if saved.committedReminderRevision == nil || saved.committedReminderRevision == capture.reminderRevision {
+                draft.reminderEnabled = saved.reminderEnabled
+                draft.reminderMode = ReminderScheduleMode(rawValue: saved.reminderMode) ?? .date
+                draft.countdownHours = saved.countdownHours; draft.countdownMinutes = saved.countdownMinutes
+                draft.reminderDate = saved.reminderDate
+            }
+            details[saved.captureID] = draft
+            observe(draft, id: saved.captureID)
+        }
+        return RecoveredNote(text: snapshot.note, destination: snapshot.note.isEmpty ? nil :
+            (snapshot.noteDestination ?? ComposerDestination(projectName: legacyProject)))
+    }
+
+    func shutdown() {
+        guard !isStopped else { return }
+        isStopped = true
+        composerSubscriptions.removeAll()
+        detailSubscriptions.removeAll()
+        for draft in details.values { draft.feedback.shutdown() }
+        onPersistenceRequested = nil
+        onNewTaskChange = nil
+        onDetailChange = nil
+    }
+
+    private func observe(_ draft: CaptureDraft, id: UUID) {
+        guard !isStopped else { return }
+        var subscriptions = Set<AnyCancellable>()
+        draft.objectWillChange.sink { [weak self, weak draft] _ in
+            guard let self, let draft, self.details[id] === draft else { return }
+            self.onDetailChange?(id, draft)
+        }.store(in: &subscriptions)
+        draft.objectWillChange.debounce(for: .milliseconds(150), scheduler: RunLoop.main)
+            .sink { [weak self] _ in self?.onPersistenceRequested?() }
+            .store(in: &subscriptions)
+        detailSubscriptions[id] = subscriptions
+    }
+}

+import Foundation
+
+/// Maintains readable mirrors after metadata commits. Failures are retryable and
+/// never roll back a committed capture. CaptureStore owns publication and error
+/// presentation; this component owns mirror state and the cancellable repair job.
+@MainActor final class CaptureArchiveMaintenance {
+    struct Outcome {
+        let removalWarning: String?
+        let repairWarning: String?
+    }
+
+    private let repository: CaptureRepository
+    private let archive: DailyArchive
+    private let projectArchive: ProjectFileArchive
+    private var failures: [UUID: String] = [:]
+    private var repairTask: Task<Void, Never>?
+    private var repairGeneration: UInt = 0
+    private var repairIDs: [UUID] = []
+    private var pendingIDs: Set<UUID> = []
+
+    var pendingCount: Int { pendingIDs.count }
+    var hasFailures: Bool { !failures.isEmpty }
+
+    init(repository: CaptureRepository, archive: DailyArchive, projectArchive: ProjectFileArchive) {
+        self.repository = repository
+        self.archive = archive
+        self.projectArchive = projectArchive
+    }
+
+    func enqueue(_ records: [Capture]) {
+        repairIDs = records.reversed().map(\.id)
+        pendingIDs = Set(repairIDs)
+    }
+
+    /// Resolve each ID against current store state at execution time, so edits,
+    /// trash and removal cannot be overwritten by an old launch snapshot.
+    func startRepair(repair: @escaping (UUID) -> Bool) {
+        guard repairTask == nil, !pendingIDs.isEmpty else { return }
+        repairGeneration &+= 1
+        let generation = repairGeneration
+        repairTask = Task { @MainActor [weak self] in
+            while !Task.isCancelled {
+                do { try await Task.sleep(for: .milliseconds(20)) }
+                catch { break }
+                guard !Task.isCancelled, let self, self.repairGeneration == generation else { break }
+                guard self.repairNext(using: repair) else { break }
+            }
+            guard let self, self.repairGeneration == generation else { return }
+            self.repairTask = nil
+        }
+    }
+
+    func cancelRepair() {
+        repairGeneration &+= 1
+        repairTask?.cancel()
+        repairTask = nil
+    }
+
+    func waitForRepair() async { await repairTask?.value }
+
+    private func nextRepairID() -> UUID? {
+        while let id = repairIDs.popLast() {
+            if pendingIDs.remove(id) != nil { return id }
+        }
+        return nil
+    }
+
+    private func repairNext(using repair: (UUID) -> Bool) -> Bool {
+        while let id = nextRepairID() {
+            if repair(id) { return true }
+        }
+        return false
+    }
+
+    func discardFailures(for ids: Set<UUID>) {
+        for id in ids { failures.removeValue(forKey: id) }
+    }
+
+    /// Child mirrors inherit the task's current project. A scoped save can repair
+    /// its folder immediately and removes redundant work from the launch queue.
+    func synchronize(_ records: [Capture], currentRecords: [Capture], removed: [Capture] = []) -> Outcome {
+        let changedIDs = Set(records.map(\.id))
+        let children = currentRecords.filter { $0.parentTaskID.map(changedIDs.contains) == true }
+        let changed = Array(Dictionary((records + children).map { ($0.id, $0) },
+                                       uniquingKeysWith: { _, latest in latest }).values)
+        let all = Array(Dictionary((currentRecords + changed).map { ($0.id, $0) },
+                                   uniquingKeysWith: { _, latest in latest }).values)
+        let explorerFailures = projectArchive.synchronizeResults(changed + removed, records: all,
+            removingIDs: Set(removed.map(\.id))) { try self.repository.save([$0]) }
+        for capture in changed {
+            do {
+                if let failure = explorerFailures[capture.id] { throw CaptureStoreError.invalidOriginal(failure) }
+                try archive.synchronize(capture)
+                failures.removeValue(forKey: capture.id)
+                pendingIDs.remove(capture.id)
+            } catch { failures[capture.id] = error.localizedDescription }
+        }
+        let removalWarning = removed.compactMap { explorerFailures[$0.id] }.first.map {
+            "The capture was removed. Its daily document could not be refreshed. \($0)"
+        }
+        let repairWarning = failures.values.first.map {
+            "Saved locally. \(failures.count) capture folder(s) could not be refreshed and will be retried when DaBin opens. \($0)"
+        }
+        return Outcome(removalWarning: removalWarning, repairWarning: repairWarning)
+    }
+}

+
+/// Isolated recovery and subscription ownership, without windows or live input.
+@main @MainActor struct AppDraftSessionTests {
+    private static var checks = 0
+
+    private static func expect(_ condition: @autoclosure () throws -> Bool, _ message: String) throws {
+        checks += 1
+        guard try condition() else {
+            throw NSError(domain: "AppDraftSessionTests", code: 1,
+                          userInfo: [NSLocalizedDescriptionKey: message])
+        }
+    }
+
+    private static func settleDebounce() {
+        RunLoop.main.run(until: Date().addingTimeInterval(0.25))
+    }
+
+    static func main() throws {
+        let root = FileManager.default.temporaryDirectory.appendingPathComponent("DaBinDraftSession-\(UUID())")
+        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: root) }
+        try identityAndRecovery(root.appendingPathComponent("Recovery"))
+        try subscriptionOwnership(root.appendingPathComponent("Subscriptions"))
+        try damagedRecovery(root.appendingPathComponent("Damaged"))
+        print("PASS: \(checks) draft-session checks; identity, exact recovery, scoped debounce, removed editors and shutdown; isolated fixtures only.")
+    }
+
+    private static func identityAndRecovery(_ root: URL) throws {
+        let store = try CaptureStore(root: root, repairArchiveOnOpen: false)
+        defer { store.cancelArchiveRepair() }
+        let capture = try store.createTask(text: "Fictional committed task")
+        let session = AppDraftSession(root: root)
+        defer { session.shutdown() }
+        let draft = session.draft(for: capture)
+        try expect(session.draft(for: capture) === draft && session.existingDraft(for: capture.id) === draft,
+                   "Repeated routes share the same mutable draft identity")
+        let editingID = UUID()
+        draft.title = "Unsubmitted title"
+        draft.commentComposer = "  Pending reply\nwith exact spacing"
+        draft.editingCommentID = editingID
+        draft.pendingChecklistText = String(repeating: "x", count: 501)
+        session.newTask.text = "Pending new task"
+        session.newTask.pendingChecklistText = "Unsubmitted composer step"
+        let note = "  Draft note\nwith trailing space "
+        session.persist(note: note, noteDestination: ComposerDestination(projectName: nil),
+                        fallbackTaskProject: "Fictional fallback")
+        try expect(session.persistenceError == nil, "An invalid unsubmitted step remains valid recovery data")
+        let recovered = AppDraftSession(root: root)
+        defer { recovered.shutdown() }
+        let noteRecovery = recovered.restore(captures: store.captures, legacyProject: "Different project")
+        try expect(noteRecovery?.text == note && noteRecovery?.destination != nil
+            && noteRecovery?.destination?.projectName == nil,
+            "An explicit Unfiled note destination and exact text survive recovery")
+        try expect(recovered.newTask.text == "Pending new task"
+            && recovered.newTask.pendingChecklistText == "Unsubmitted composer step"
+            && recovered.newTask.destination?.projectName == "Fictional fallback",
+            "The composer restores pending text and its persisted fallback destination")
+        let restored = recovered.draft(for: capture)
+        try expect(restored.title == "Unsubmitted title" && restored.pendingChecklistText.count == 501
+            && restored.commentComposer == draft.commentComposer && restored.editingCommentID == editingID,
+            "Recovery keeps invalid typed text and the exact reply editing identity")
+        try expect(recovered.draft(for: capture) === restored, "Opening a recovered draft never replaces its owner")
+        try expect(capture.title == "Fictional committed task" && capture.comment.isEmpty
+            && capture.taskPlanning?.checklist.isEmpty != false,
+            "Recovering edits does not commit them to the live record")
+        let missing = AppDraftSession(root: root)
+        defer { missing.shutdown() }
+        _ = missing.restore(captures: [], legacyProject: nil)
+        try expect(missing.existingDraft(for: capture.id) == nil, "Recovery skips records no longer in the active archive")
+    }
+
+    private static func subscriptionOwnership(_ root: URL) throws {
+        let store = try CaptureStore(root: root, repairArchiveOnOpen: false)
+        defer { store.cancelArchiveRepair() }
+        let capture = try store.createTask(text: "Fictional subscription task")
+        let session = AppDraftSession(root: root)
+        defer { session.shutdown() }
+        let note = SessionNote()
+        var requests = 0, taskChanges = 0, detailChanges = 0
+        session.onPersistenceRequested = { requests += 1 }
+        session.onNewTaskChange = { taskChanges += 1 }
+        session.onDetailChange = { [weak session] id, draft in
+            if id == capture.id && session?.existingDraft(for: id) === draft { detailChanges += 1 }
+        }
+        session.observeComposers(noteChanges: note.$text)
+        session.observeComposers(noteChanges: note.$text)
+        settleDebounce()
+        try expect(requests == 0, "Installing observers is idempotent and does not persist initial values")
+        note.text = "First note edit"; note.text = "Final note edit"
+        settleDebounce()
+        try expect(requests == 1, "Rapid published note edits request one debounced persistence")
+        session.newTask.text = "Pending task"; session.newTask.pendingChecklistText = "Pending step"
+        try expect(taskChanges >= 2, "Composer updates immediately reach the presentation facade")
+        settleDebounce()
+        try expect(requests == 2, "Task model edits have one owned debounce subscription")
+        let retired = session.draft(for: capture)
+        retired.title = "Pending title"; retired.commentComposer = "Pending reply"
+        try expect(detailChanges >= 2 && session.hasDetailChanges, "The active editor reports changes through its owner")
+        settleDebounce()
+        try expect(requests == 3, "A detail editor requests one persistence after its edit burst")
+        let beforeRemoval = detailChanges
+        session.removeDraft(for: capture.id)
+        retired.title = "Retired editor edit"; retired.commentComposer = "Retired reply"
+        settleDebounce()
+        try expect(requests == 3 && detailChanges == beforeRemoval && !session.hasDetailChanges,
+                   "Removed editors cannot emit persistence or presentation changes")
+        let replacement = session.draft(for: capture)
+        try expect(replacement !== retired && replacement.title == capture.title,
+                   "Reopening a removed editor creates a fresh owner from committed data")
+        replacement.commentComposer = "Pending when shutdown starts"
+        let beforeShutdown = detailChanges
+        session.shutdown()
+        note.text = "After shutdown"; session.newTask.text = "After shutdown"
+        replacement.title = "After shutdown"
+        settleDebounce()
+        try expect(requests == 3 && detailChanges == beforeShutdown,
+                   "Shutdown cancels pending persistence and every editor subscription")
+        try expect(replacement.commentComposer == "Pending when shutdown starts",
+                   "Shutting down observers does not clear recoverable editor text")
+    }
+
+    private static func damagedRecovery(_ root: URL) throws {
+        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)
+        let file = root.appendingPathComponent("Drafts.json")
+        let damaged = Data("{fictional damaged recovery".utf8)
+        try damaged.write(to: file)
+        let session = AppDraftSession(root: root)
+        defer { session.shutdown() }
+        var errors: [String?] = []
+        session.onPersistenceErrorChange = { errors.append($0) }
+        try expect(session.restore(captures: [], legacyProject: nil) == nil
+            && session.persistenceError != nil && errors.count == 1,
+            "Recovery failure is exposed to the app facade")
+        session.newTask.text = "Still held in memory"
+        session.persist(note: "Pending note", noteDestination: nil, fallbackTaskProject: nil)
+        try expect(session.persistenceError != nil && session.newTask.text == "Still held in memory"
+            && errors.count == 2, "Rejected persistence retains editable data and reports its failure")
+        try expect(try Data(contentsOf: file) == damaged, "A damaged recovery file remains byte-for-byte untouched")
+    }
+}

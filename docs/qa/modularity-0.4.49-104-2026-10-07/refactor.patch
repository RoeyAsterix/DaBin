+import AppKit
+import SwiftUI
+
+/// Own-process QA refuses Copy unless normal responder lookup exposes its
+/// explicitly injected private destination. This never redirects child editors.
+@MainActor protocol ProjectWorkspaceCopyDelivery: AnyObject {
+    var projectCopyPasteboardName: NSPasteboard.Name { get }
+}
+
+/// Read-only completeness receipt for the bounded row-refresh experiment.
+/// It reports root assignment, while the caller still performs native layout.
+@MainActor protocol ProjectWorkspaceRowRefreshReadiness: AnyObject {
+    var hasPendingRowRefresh: Bool { get }
+    var lastAppliedZoomFactor: CGFloat? { get }
+}
+
+/// An owned native table retains its rows and hosting views while typography
+/// changes. It uses only AppKit's automatic heights and ordinary reuse; no
+/// offscreen row measurement is involved. Keyboard traversal crosses an owned
+/// hosting boundary only after its ordinary in-row key-view chain ends.
+@MainActor struct ProjectWorkspaceNativeTable: NSViewRepresentable {
+    let layout: ProjectWorkspaceRows
+    let inputs: ProjectWorkspaceBrowserInputs
+    let state: AppState
+    let actions: ProjectWorkspaceBrowserActions
+    let focus: Binding<String?>
+    @Environment(\.self) private var environment
+
+    private static let columnID = NSUserInterfaceItemIdentifier("project-native-column")
+    private static let cellID = NSUserInterfaceItemIdentifier("project-native-row")
+
+    init(layout: ProjectWorkspaceRows, inputs: ProjectWorkspaceBrowserInputs, state: AppState,
+         actions: ProjectWorkspaceBrowserActions, focus: Binding<String?>) {
+        self.layout = layout
+        self.inputs = inputs
+        self.state = state
+        self.actions = actions
+        self.focus = focus
+    }
+
+    struct Snapshot {
+        let layout: ProjectWorkspaceRows
+        let inputs: ProjectWorkspaceBrowserInputs
+        let state: AppState
+        let actions: ProjectWorkspaceBrowserActions
+        let focus: Binding<String?>
+        let environment: EnvironmentValues
+    }
+
+    private var snapshot: Snapshot {
+        Snapshot(layout: layout, inputs: inputs, state: state, actions: actions,
+                 focus: focus, environment: environment)
+    }
+
+    func makeCoordinator() -> Coordinator { Coordinator() }
+
+    func makeNSView(context: Context) -> NSScrollView {
+        let scroll = NSScrollView()
+        scroll.drawsBackground = false
+        scroll.borderType = .noBorder
+        scroll.hasVerticalScroller = true
+        scroll.hasHorizontalScroller = false
+        scroll.autohidesScrollers = true
+        scroll.scrollerStyle = .overlay
+        scroll.setAccessibilityIdentifier("project-items")
+
+        let table = Table(frame: NSRect(x: 0, y: 0, width: 1, height: 1))
+        table.headerView = nil
+        table.style = .plain
+        table.backgroundColor = .clear
+        table.usesAlternatingRowBackgroundColors = false
+        table.gridStyleMask = []
+        table.intercellSpacing = .zero
+        table.selectionHighlightStyle = .none
+        table.allowsEmptySelection = true
+        table.usesAutomaticRowHeights = true
+        table.rowHeight = 200 // Estimate only; each instantiated row supplies its intrinsic height.
+        table.columnAutoresizingStyle = .lastColumnOnlyAutoresizingStyle
+        table.autoresizingMask = [.width]

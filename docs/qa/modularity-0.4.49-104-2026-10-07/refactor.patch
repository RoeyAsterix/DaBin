+import Combine
+import Foundation
+
+/// The feed owns live records; only its membership, order and grouping are cached.
+/// Collapse, previews and editable labels continue to read each Capture directly.
+struct CaptureDayPresentation {
+    let day: Date
+    let allCaptures: [Capture]
+    let captures: [Capture]
+    let cards: [CaptureFeedCard]
+}
+
+struct CaptureWeekPresentation {
+    let days: [Date]
+    let columns: [CaptureDayPresentation]
+    let selectionCaptures: [Capture]
+}
+
+/// Index immutable receipt days once instead of scanning the archive for every
+/// count, column and selection query. Task publications invalidate only derived
+/// membership; unrelated preview/status publications do not rebuild the feed.
+@MainActor
+final class CaptureTimelinePresentationCache {
+    private final class Entry {
+        let capture: Capture
+        var convertedToTask: Bool
+        var isCompleted: Bool
+        var reminderAt: Date?
+        var subscriptions = Set<AnyCancellable>()
+        var observesTaskInputs = false
+
+        init(_ capture: Capture) {
+            self.capture = capture
+            convertedToTask = capture.convertedToTask
+            isCompleted = capture.isCompleted
+            reminderAt = capture.reminderAt
+        }
+
+        var matchesPublishedValues: Bool {
+            (capture.kind == .task || capture.convertedToTask == convertedToTask)
+                && capture.isCompleted == isCompleted && capture.reminderAt == reminderAt
+        }
+    }
+
+    private struct DayKey: Hashable {
+        let day: String
+        let timeZone: TimeZone
+    }
+    private struct FeedKey: Hashable {
+        let day: DayKey
+        let filter: CaptureFilter
+        let today: String
+        let calendar: Calendar
+    }
+    private struct WeekKey: Equatable {
+        let days: [Date]
+        let filter: CaptureFilter
+        let today: String
+        let calendar: Calendar
+    }
+
+    private var entries: [UUID: Entry] = [:]
+    private var taskEntries: [UUID: Entry] = [:]
+    private var receiptsByDay: [String: [Capture]] = [:]
+    private var dayCache: [DayKey: [Capture]] = [:]
+    private var feedCache: [FeedKey: CaptureDayPresentation] = [:]
+    private var weekKey: WeekKey?
+    private var weekCache: CaptureWeekPresentation?
+    var onChange: (() -> Void)?
+
+    init(captures: [Capture] = []) { replaceCaptures(captures) }
+
+    /// Call with the publisher's incoming array, not store.captures: @Published
+    /// emits before that property is assigned. Reuse subscriptions for live IDs.
+    func replaceCaptures(_ captures: [Capture]) {
+        var nextEntries: [UUID: Entry] = [:]
+        nextEntries.reserveCapacity(captures.count)
+        for capture in captures {
+            let entry: Entry
+            if let existing = entries[capture.id], existing.capture === capture {
+                entry = existing
+            } else {
+                entry = Entry(capture)
+                observeRole(entry)
+            }
+            nextEntries[capture.id] = entry
+        }
+        entries = nextEntries
+        // Retain a previously converted candidate during a willSet transition.
+        // Once the source array is republished, inactive candidates can go away.
+        taskEntries = entries.filter { $0.value.capture.isTask || $0.value.convertedToTask }
+        for entry in taskEntries.values { observeTaskInputs(entry) }
+        receiptsByDay = Dictionary(grouping: captures.sorted(by: Self.newestFirst), by: \.captureDay)
+        invalidate()
+    }
+
+    private func observeRole(_ entry: Entry) {
+        guard entry.capture.kind != .task else { return }
+        entry.capture.$convertedToTask.dropFirst().sink { [weak self, weak entry] value in
+            guard let self, let entry, entry.convertedToTask != value else { return }
+            entry.convertedToTask = value
+            self.taskEntries[entry.capture.id] = entry
+            self.observeTaskInputs(entry)
+            self.invalidate()
+        }.store(in: &entry.subscriptions)
+    }
+
+    private func observeTaskInputs(_ entry: Entry) {
+        guard !entry.observesTaskInputs else { return }
+        entry.observesTaskInputs = true
+        entry.isCompleted = entry.capture.isCompleted
+        entry.reminderAt = entry.capture.reminderAt
+        entry.capture.$isCompleted.dropFirst().sink { [weak self, weak entry] value in
+            guard let self, let entry, entry.isCompleted != value else { return }
+            entry.isCompleted = value
+            self.invalidate()
+        }.store(in: &entry.subscriptions)
+        entry.capture.$reminderAt.dropFirst().sink { [weak self, weak entry] value in
+            guard let self, let entry, entry.reminderAt != value else { return }
+            entry.reminderAt = value
+            self.invalidate()
+        }.store(in: &entry.subscriptions)
+    }
+
+    private func invalidate() {
+        dayCache.removeAll(keepingCapacity: true)
+        feedCache.removeAll(keepingCapacity: true)
+        weekKey = nil
+        weekCache = nil
+        onChange?()
+    }
+
+    /// A synchronous subscriber can query during a Capture's willSet. Return
+    /// the currently readable state then, but never commit it under the incoming
+    /// publication, or the next read would retain the old completion/reminder.
+    private var canCache: Bool { taskEntries.values.allSatisfy(\.matchesPublishedValues) }
+
+    func allCaptures(for day: Date, timeZone: TimeZone = .current) -> [Capture] {
+        let key = DayKey(day: CaptureCalendar.dayString(day, timeZone: timeZone), timeZone: timeZone)
+        if let cached = dayCache[key] { return cached }
+        let promoted = taskEntries.values.map(\.capture).filter {
+            Self.isTaskAtTop($0, dayKey: key.day, timeZone: timeZone)
+        }.sorted(by: Self.newestFirst)
+        let promotedIDs = Set(promoted.map(\.id))
+        let result = promoted + (receiptsByDay[key.day] ?? []).filter { !promotedIDs.contains($0.id) }
+        if canCache {
+            if dayCache.count >= 32 { dayCache.removeAll(keepingCapacity: true) }
+            dayCache[key] = result
+        }
+        return result
+    }
+
+    func presentation(for day: Date, filter: CaptureFilter, today: Date = Date(),
+                      calendar: Calendar = .current) -> CaptureDayPresentation {
+        let key = FeedKey(day: DayKey(day: CaptureCalendar.dayString(day, timeZone: calendar.timeZone),
+                                     timeZone: calendar.timeZone), filter: filter,
+                          today: CaptureCalendar.dayString(today, timeZone: calendar.timeZone), calendar: calendar)
+        if let cached = feedCache[key] {
+            return CaptureDayPresentation(day: day, allCaptures: cached.allCaptures,
+                                          captures: cached.captures, cards: cached.cards)
+        }
+        let all = allCaptures(for: day, timeZone: calendar.timeZone)
+        let result = CaptureDayPresentation(day: day, allCaptures: all,
+            captures: all.filter { filter.includes($0) },
+            cards: HourlyCaptureFeed.cards(from: all, filter: filter, today: today, calendarTimeZone: calendar.timeZone))
+        if canCache {
+            if feedCache.count >= 32 { feedCache.removeAll(keepingCapacity: true) }
+            feedCache[key] = result
+        }
+        return result
+    }
+
+    func week(days: [Date], filter: CaptureFilter, today: Date = Date(),
+              calendar: Calendar = .current) -> CaptureWeekPresentation {
+        let key = WeekKey(days: days, filter: filter,
+                          today: CaptureCalendar.dayString(today, timeZone: calendar.timeZone), calendar: calendar)
+        if weekKey == key, let weekCache { return weekCache }
+        let columns = days.map { presentation(for: $0, filter: filter, today: today, calendar: calendar) }
+            .filter { !$0.captures.isEmpty }
+        let result = CaptureWeekPresentation(days: days, columns: columns,
+            selectionCaptures: columns.flatMap { $0.cards.flatMap(\.captures) })
+        if canCache { weekKey = key; weekCache = result }
+        return result
+    }
+
+    private static func newestFirst(_ lhs: Capture, _ rhs: Capture) -> Bool {
+        lhs.capturedAt == rhs.capturedAt ? lhs.id.uuidString < rhs.id.uuidString : lhs.capturedAt > rhs.capturedAt
+    }
+
+    private static func isTaskAtTop(_ capture: Capture, dayKey: String, timeZone: TimeZone) -> Bool {
+        guard capture.isTask, !capture.isCompleted, capture.captureDay <= dayKey else { return false }
+        if let reminder = capture.reminderAt {
+            return CaptureCalendar.dayString(reminder, timeZone: timeZone) == dayKey
+        }
+        return capture.captureDay < dayKey
+    }
+}

+import AppKit
+import SwiftUI
+
+/// These are all non-zoom inputs to the browser. The revision changes whenever
+/// archive/workspace content is rebuilt, including replacement captures and
+/// scratchpad text. Independent Capture observers still deliver live edits.
+struct ProjectWorkspaceBrowserInputs: Equatable {
+    let actionsID: ObjectIdentifier
+    let stateID: ObjectIdentifier
+    let storeID: ObjectIdentifier
+    let revision: UInt64
+    let project: String
+    let filter: String
+    let dateFilter: String
+    let columns: Int
+    let compact: Bool
+    let selection: Set<String>
+    let selectionAnchor: String?
+    let focusedItem: String?
+    let historyAnchor: NavigationViewportAnchor?
+    let color: Color
+    let emptyProject: Bool
+    let busy: Bool
+    let navigationBlocked: Bool
+
+    func cardPresentation(for itemID: String) -> ProjectWorkspaceCardPresentation {
+        ProjectWorkspaceCardPresentation(actionsID: actionsID, stateID: stateID, storeID: storeID,
+            revision: revision, selected: selection.contains(itemID), focused: focusedItem == itemID,
+            compact: compact, color: color)
+    }
+}
+
+/// A card depends on its own selection/focus and current content owner, rather
+/// than the browser's filters, history anchor or another item's selection.
+/// Keep the content revision so restored models with the same item ID and live
+/// scratchpad snapshots replace the card's callbacks and displayed content.
+struct ProjectWorkspaceCardPresentation: Equatable {
+    let actionsID: ObjectIdentifier
+    let stateID: ObjectIdentifier
+    let storeID: ObjectIdentifier
+    let revision: UInt64
+    let selected: Bool
+    let focused: Bool
+    let compact: Bool
+    let color: Color
+}
+
+/// Font/preview scaling remains inside ProjectWorkspaceCard. The equality
+/// boundary only keeps the row's zoom spacing from replacing card callbacks
+/// and focus controls that have otherwise retained the same content/state.
+@MainActor private struct ProjectWorkspaceBrowserCard: View, Equatable {
+    let item: ProjectWorkspaceItem
+    let itemID: String
+    let presentation: ProjectWorkspaceCardPresentation
+    let state: AppState
+    let actions: ProjectWorkspaceBrowserActions
+    let focus: FocusState<String?>.Binding
+
+    nonisolated static func == (lhs: Self, rhs: Self) -> Bool {
+        lhs.itemID == rhs.itemID && lhs.presentation == rhs.presentation
+    }
+
+    var body: some View {
+        ProjectWorkspaceCard(state: state, item: item, selected: presentation.selected,
+            compact: presentation.compact, color: presentation.color, focus: focus,
+            open: { actions.open(item) }, select: { actions.select(item) }, details: { actions.details(item) },
+            makeTask: { actions.makeTasks([item]) }, drag: { try actions.drag(item) })
+    }
+}
+
+@MainActor struct ProjectWorkspaceBrowserRow: View {
+    let row: ProjectWorkspaceRow
+    let inputs: ProjectWorkspaceBrowserInputs
+    let state: AppState
+    let actions: ProjectWorkspaceBrowserActions
+    @Binding var focus: String?
+    @FocusState private var rowFocus: String?
+
+    @Environment(\.workspaceZoom) private var zoom
+    @Environment(\.layoutDirection) private var layoutDirection
+
+    init(row: ProjectWorkspaceRow, inputs: ProjectWorkspaceBrowserInputs, state: AppState,
+         actions: ProjectWorkspaceBrowserActions, focus: Binding<String?>) {
+        self.row = row
+        self.inputs = inputs
+        self.state = state
+        self.actions = actions
+        self._focus = focus
+    }
+
+    var body: some View {
+        ProjectWorkspaceRowLayout(spacing: zoom.value(12), direction: layoutDirection) {
+            ForEach(row.items) { item in
+                ProjectWorkspaceBrowserCard(item: item, itemID: item.id, presentation: inputs.cardPresentation(for: item.id),
+                    state: state, actions: actions, focus: $rowFocus).equatable().frame(maxWidth: .infinity)
+            }
+            ForEach(0..<max(0, inputs.columns - row.items.count), id: \.self) { _ in
+                Color.clear.frame(maxWidth: .infinity)
+            }
+        }
+        // Each hosting tree owns its native focus registration. Logical focus
+        // survives a non-key window or virtualization; only its matching row
+        // requests native focus when that row is mounted again.
+        .onChange(of: focus, initial: true) { _, desired in
+            guard focus == desired else { return }
+            if let desired {
+                // Another row taking focus is an AppKit transfer. Explicitly
+                // clearing this independent host can clear the new responder
+                // after the click that transferred it has already completed.
+                guard row.items.contains(where: { $0.id == desired }) else { return }
+                if rowFocus != desired { rowFocus = desired }
+            } else if rowFocus != nil {
+                // Observe the global value so a deliberate nil also reaches
+                // a retained row whose item was not the previous logical owner.
+                rowFocus = nil
+            }
+        }
+        .onChange(of: rowFocus) { _, claimed in
+            // An inactive/recycled row losing native focus must not clear the
+            // current logical owner. The row-ID scope resets state on reuse.
+            guard let claimed, rowFocus == claimed, row.items.contains(where: { $0.id == claimed }),
+                  focus != claimed else { return }
+            focus = claimed
+        }
+    }
+}
+
+/// A native row is a separate SwiftUI tree. Resolve its anchors locally and
+/// reset the local controller when that native host is reused for another row.
+/// Forward public presentation settings explicitly. The new hosting tree keeps
+/// its own focus/hosting context, and the scope owns its tooltip controller.
+@MainActor
+struct ProjectWorkspaceRowTooltipScope: ViewModifier {
+    let rowID: String
+    let environment: EnvironmentValues
+
+    func body(content: Content) -> some View {
+        content.hoverTooltips().clipped().id(rowID)
+            .environment(\.locale, environment.locale)
+            .environment(\.calendar, environment.calendar)
+            .environment(\.timeZone, environment.timeZone)
+            .environment(\.colorScheme, environment.colorScheme)
+            .environment(\.layoutDirection, environment.layoutDirection)
+            .environment(\.displayScale, environment.displayScale)
+            .environment(\.isEnabled, environment.isEnabled)
+            .environment(\.font, environment.font)
+            .environment(\.controlSize, environment.controlSize)
+            .environment(\.dynamicTypeSize, environment.dynamicTypeSize)
+            .environment(\.legibilityWeight, environment.legibilityWeight)
+            .environment(\.openURL, environment.openURL)
+            .environment(\.workspaceZoom, environment.workspaceZoom)
+            .environment(\.daBinAccent, environment.daBinAccent)
+            .environment(\.daBinTooltipsEnabled, environment.daBinTooltipsEnabled)
+            .environment(\.daBinTutorialTargets, environment.daBinTutorialTargets)
+            .tint(environment.daBinAccent)
+    }
+}
+
+/// The native table and both existing viewport bridges share the same browser
+/// bounds. Empty content stays in SwiftUI and never becomes a synthetic data row.
+@MainActor struct ProjectWorkspaceBrowser: View, Equatable {
+    let layout: ProjectWorkspaceRows
+    let inputs: ProjectWorkspaceBrowserInputs
+    let state: AppState
+    let store: CaptureStore
+    let actions: ProjectWorkspaceBrowserActions
+    let focus: Binding<String?>
+
+    nonisolated static func == (lhs: Self, rhs: Self) -> Bool { lhs.inputs == rhs.inputs }
+
+    var body: some View {
+        Group {
+            if layout.rows.isEmpty {
+                VStack(spacing: 8) {
+                    EmptyMessage(symbol: "folder", title: inputs.emptyProject ? "Make room for your next idea" : "No matching items",
+                        message: inputs.emptyProject ? "Drop a file or paste something into this project. Your notes, links and tasks will live here too." : "Try another filter or show the complete project.")
+                    if !inputs.emptyProject {
+                        Button("Show all items") { actions.resetFilters() }
+                            .frame(minHeight: 32).accessibilityIdentifier("project-reset-filters")
+                    }
+                }.padding(EdgeInsets(top: 5, leading: 16, bottom: 7, trailing: 16))
+                    .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .top)
+            } else {
+                ProjectWorkspaceNativeTable(layout: layout, inputs: inputs, state: state, actions: actions, focus: focus)
+                    .frame(maxWidth: .infinity, maxHeight: .infinity)
+            }
+        }
+            .transaction { $0.animation = nil; $0.disablesAnimations = true }
+            .background {
+                ExplorerViewport(store: store, rowIDs: layout.rowIDs,
+                    context: ExplorerViewportContext(project: inputs.project, unfiledOnly: false, dailyFiles: false,
+                        query: "", filter: inputs.filter, pinnedOnly: false, dateFilter: inputs.dateFilter,
+                        source: nil, origin: "all", grouping: "project-\(inputs.columns)-\(inputs.compact)-newest", selectedID: nil), handlesZoom: false)
+                    .allowsHitTesting(false).accessibilityHidden(true)
+            }
+            .background {
+                WorkspaceZoomViewport(groups: layout.groups, historyAnchor: inputs.historyAnchor,
+                    onHistoryAnchor: { actions.recordHistory($0) })
+                    .allowsHitTesting(false).accessibilityHidden(true)
+            }
+            .accessibilityElement(children: .contain)
+            .accessibilityIdentifier("project-items")
+    }
+}
+
+/// Keep scale and gesture column locking inside the browser viewport. The
+/// project toolbar, selection actions and copy command retain their independent
+/// state dependencies while rows continue observing the live zoom environment.
+@MainActor struct ProjectWorkspaceColumnViewport<Content: View>: View {
+    let compact: Bool
+    private let content: (Int) -> Content
+    @Environment(\.workspaceZoom) private var zoom
+    @State private var gestureColumns: Int?
+    @State private var settledColumns = 1
+
+    init(compact: Bool, @ViewBuilder content: @escaping (Int) -> Content) {
+        self.compact = compact
+        self.content = content
+    }
+
+    var body: some View {
+        GeometryReader { geometry in
+            let proposedColumns = WorkspaceZoomLayout(factor: zoom.factor).columns(for: geometry.size.width, compact: compact)
+            let columns = compact ? 1 : zoom.isInteracting ? (gestureColumns ?? settledColumns) : proposedColumns
+            content(columns)
+                .onAppear { settledColumns = proposedColumns }
+                .onChange(of: proposedColumns) { _, value in if !zoom.isInteracting { settledColumns = value } }
+                .onChange(of: zoom.isInteracting) { _, active in
+                    gestureColumns = active ? settledColumns : nil
+                    if !active { settledColumns = proposedColumns }
+                }
+        }
+    }
+}

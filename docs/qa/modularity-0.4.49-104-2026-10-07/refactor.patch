+            hosting.setContentCompressionResistancePriority(.defaultLow, for: .horizontal)
+            hosting.setContentHuggingPriority(.defaultHigh, for: .vertical)
+            hosting.setContentCompressionResistancePriority(.required, for: .vertical)

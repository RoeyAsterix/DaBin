+    private static func commentEditor(in view: NSView) throws -> NSTextView {
+        func find(_ view: NSView) -> NSTextView? {
+            if let editor = view as? NSTextView, editor.isEditable { return editor }
+            return view.subviews.lazy.compactMap(find).first
+        }
+        guard let editor = find(view), editor.window === view.window else {
+            throw failure("The fictional comment fixture must own its mounted native text editor")
+        }
+        return editor
+    }
+
+    private static func typeComment(_ text: String, in editor: NSTextView, host: NSView) async throws {
+        guard let window = host.window else { throw failure("Comment typing requires its own fixture window") }
+        try expect(window.makeFirstResponder(editor), "The owned comment editor accepts native typing focus")
+        editor.insertText(text, replacementRange: NSRange(location: 0, length: (editor.string as NSString).length))
+        try await settle(host)
+        try expect(try commentEditor(in: host).string == text, "The native composer retains exact typed text")
     }
 

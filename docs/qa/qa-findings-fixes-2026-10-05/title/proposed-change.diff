+        }
+        field.textColor = NSColor(Palette.foreground)
+        if field.isEnabled != isEnabled { field.isEnabled = isEnabled }
+        field.setAccessibilityHelp(text)
+        context.coordinator.applyFocus(to: field)
+    }
